# bugnet.sh behind HAProxy's SNI split (data-plane 15.1 and 15.2, website plan section 3).
# deploy.sh replaces {{ROOT}} with /opt/bugnet/website/<version>/out.
{
    admin off
    persist_config off
    # bugnet-edge owns :80 and redirects it, so Caddy never binds it
    auto_https disable_redirects
    default_bind 127.0.0.1
    https_port 8446
    storage file_system /var/lib/bugnet-website/caddy
    grace_period 10s

    # Certificates by TLS-ALPN-01 through the split only
    cert_issuer acme {
        disable_http_challenge
    }

    servers {
        listener_wrappers {
            proxy_protocol {
                timeout 5s
                allow 127.0.0.1/32
            }
            tls
        }
        # The firewall drops UDP 443, so no Alt-Svc for HTTP/3
        protocols h1 h2
        # A preview can set cookies for all of bugnet.sh, so a large jar must never fail
        max_header_size 1MiB
        timeouts {
            read_header 10s
        }
    }
}

www.bugnet.sh {
    redir https://bugnet.sh{uri} 308
}

bugnet.sh {
    encode zstd gzip

    # Payments' feed first, since /api/stats* below matches it too
    handle /api/stats/payments* {
        reverse_proxy 127.0.0.1:8450
    }

    handle /api/stats* {
        reverse_proxy 127.0.0.1:8082
    }

    handle {
        root * {{ROOT}}
        # headers.caddy sits beside this file: each page's CSP, with its inline script hashes
        import headers.caddy

        # Pages revalidate, so one never asks for chunks an older build had
        @pages not path /_next/static/*
        header @pages Cache-Control "no-cache"
        header /_next/static/* Cache-Control "public, max-age=31536000, immutable"

        try_files {path} {path}index.html {path}/index.html
        file_server
    }

    handle_errors 404 {
        root * {{ROOT}}
        # route keeps this order, so the page matchers see /404.html
        route {
            rewrite * /404.html
            import headers.caddy
            header Cache-Control "no-cache"
            file_server
        }
    }
}
