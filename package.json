{
    "name": "bugnet-website",
    "private": true,
    "type": "module",
    "packageManager": "pnpm@12.6.0",
    "engines": {
        "node": ">=26"
    },
    "scripts": {
        "build": "pnpm -r build",
        "test": "vitest run",
        "typecheck": "pnpm -r typecheck",
        "lint": "eslint . && prettier --check .",
        "format": "prettier --write .",
        "dev": "pnpm --filter @bugnet/session-page dev",
        "dev:site": "pnpm --filter @bugnet/site dev",
        "contrast": "tsx packages/brand/src/contrast-main.ts"
    },
    "devDependencies": {
        "@eslint/js": "10.0.1",
        "@types/jsdom": "30.0.0",
        "@types/node": "26.6.6",
        "esbuild": "0.28.2",
        "eslint": "10.14.0",
        "jsdom": "30.1.2",
        "playwright-core": "1.64.0",
        "prettier": "3.9.10",
        "tsx": "4.23.15",
        "typescript": "6.0.3",
        "typescript-eslint": "8.72.1",
        "vitest": "5.1.0"
    }
}
