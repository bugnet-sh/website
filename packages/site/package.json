{
    "name": "@bugnet/site",
    "version": "0.1.0",
    "private": true,
    "type": "module",
    "scripts": {
        "dev": "tsx scripts/search-index.ts && tsx scripts/images.ts && NEXT_TELEMETRY_DISABLED=1 next dev",
        "build": "tsx scripts/search-index.ts && tsx scripts/images.ts && NEXT_TELEMETRY_DISABLED=1 next build && tsx scripts/postbuild.ts",
        "typecheck": "NEXT_TELEMETRY_DISABLED=1 next typegen && tsc -p ."
    },
    "dependencies": {
        "@bugnet/brand": "workspace:*",
        "github-slugger": "2.0.0",
        "lucide-react": "1.70.0",
        "mermaid": "12.2.0",
        "next": "16.4.5",
        "react": "19.3.1",
        "react-dom": "19.3.1",
        "react-markdown": "10.1.0",
        "recharts": "3.10.1",
        "remark-gfm": "4.0.1",
        "remark-parse": "11.0.0",
        "unified": "11.0.5"
    },
    "devDependencies": {
        "@tailwindcss/postcss": "4.3.5",
        "@testing-library/dom": "10.4.2",
        "@testing-library/react": "16.3.3",
        "@types/mdast": "4.0.4",
        "@types/react": "19.3.0",
        "@types/react-dom": "19.3.0",
        "sharp": "0.35.5",
        "tailwindcss": "4.3.5"
    }
}
